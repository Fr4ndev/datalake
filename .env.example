# ---- TimescaleDB -----------------------------------------------------------
# El schema lo crea tsdb/migrate.py (migraciones versionadas), NO initdb.
POSTGRES_USER=marketdata
POSTGRES_PASSWORD=cambia-esta-password
POSTGRES_DB=marketdata
# Puerto publicado solo en 127.0.0.1
POSTGRES_PORT=5432

# ---- Compression ------------------------------------------------------------
# false durante TODO el backfill historico: insertar con ON CONFLICT sobre chunks
# comprimidos es muy lento. Poner a true solo tras historico cargado + caggs refrescados.
ENABLE_COMPRESSION=false

# ---- Lake Parquet -----------------------------------------------------------
# Ruta dentro del contenedor (montada desde ./lake en compose)
LAKE_DIR=/data/lake

# ---- Telegram (skill telegram-strategy-receiver) ---------------------------
# Secretos: solo aqui y en .env, nunca en el repo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Ownership del lake ----------------------------------------------------
# UID/GID con los que corren los servicios Python dentro del contenedor, para que lo que
# escriben en ./lake sea tuyo y no de root. `UID` no sirve: bash no la exporta.
LAKE_UID=1000
LAKE_GID=1000

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO